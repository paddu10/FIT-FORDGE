      "package": "com.fitforge.app",
      "adaptiveIcon": {
        "backgroundColor": "#08090C",
        "foregroundImage": "./assets/icon.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "409ae8b0-755e-490c-ac39-fdabb0fcbf59"
      }
    }
  }
}
